# Prompt preset. Use custom to keep only the explicit .env defaults below.
DANBOORU_PROMPT_MODEL_PRESET=wai_illustrious

# Convert natural language into matched Danbooru tags. Disable this if you only
# want defaults/quality/rating/negative assembly around manual comma tags.
DANBOORU_PROMPT_TAG_MATCHING=1

# Local LLM planner. SQLite remains the authority for final tag lookup/ranking.
# Set LLM_PROVIDER to openai to use any OpenAI-compatible chat completions
# server instead (LM Studio, llama.cpp, vLLM, Ollama /v1, OpenAI, ...).
DANBOORU_PROMPT_USE_OLLAMA=1
DANBOORU_PROMPT_LLM_PROVIDER=ollama
DANBOORU_PROMPT_OLLAMA_MODEL=gemma4:e4b
DANBOORU_PROMPT_OLLAMA_URL=http://127.0.0.1:11434

# OpenAI-compatible backend, used when LLM_PROVIDER=openai.
# base_url may include or omit the /v1 suffix. api_key may stay empty for
# local servers that do not require authentication.
DANBOORU_PROMPT_OPENAI_MODEL=gpt-4o-mini
DANBOORU_PROMPT_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
DANBOORU_PROMPT_OPENAI_API_KEY=

# Second-pass LLM cleanup. After SQLite tag matching, this asks Ollama to
# recover important unmatched details as short natural-language fragments.
DANBOORU_PROMPT_SMART_FORMATTING=1
DANBOORU_PROMPT_SMART_FORMAT_MAX_FRAGMENTS=4
DANBOORU_PROMPT_DYNAMIC_SMART_FORMATTING=1
DANBOORU_PROMPT_DYNAMIC_SMART_FORMAT_MIN_FRAGMENTS=4
DANBOORU_PROMPT_DYNAMIC_SMART_FORMAT_MAX_FRAGMENTS=20

# Illustrious/WAI defaults. These are added unless the user asks for no defaults
# or the CLI/node disables defaults.
DANBOORU_PROMPT_INCLUDE_DEFAULTS=1
DANBOORU_PROMPT_DEFAULT_POSITIVE=masterpiece,best quality,amazing quality
DANBOORU_PROMPT_DEFAULT_NEGATIVE=bad quality,worst quality,worst detail,sketch,censor

# Safety rating tags: general, sensitive, nsfw, explicit, or empty.
# Defaulting to general keeps ordinary prompts away from explicit rating space.
DANBOORU_PROMPT_DEFAULT_RATING=general
